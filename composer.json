{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pcteckserv/cmspcteckserv-starter",
    "type": "project",
    "description": "Base Laravel e CMS PCTECKSERV para novos websites.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.40",
        "laravel/tinker": "^3.0",
        "pcteckserv/cms-contact-forms": "^2.0.0",
        "pcteckserv/cms-core": "^3.5.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "name": "cms-plugin-contact-forms",
            "type": "path",
            "url": "storage/framework/cache/cms-plugin-repository/cmspcteckserv-formularios-de-contacto",
            "options": {
                "symlink": false,
                "versions": {
                    "pcteckserv/cms-contact-forms": "2.0.0"
                }
            }
        },
        {
            "type": "git",
            "url": "https://github.com/pcteckserv/cmspcteckserv-core.git"
        }
    ],
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "pre-install-cmd": [
            "@php tools/validate-plugin-catalog.php"
        ],
        "pre-update-cmd": [
            "@php tools/validate-plugin-catalog.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "github-protocols": [
            "https"
        ],
        "platform": {
            "php": "8.3.36"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
